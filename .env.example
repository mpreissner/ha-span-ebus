# --- SPAN panel -------------------------------------------------------------
# Panel IP or hostname. Discovered via mDNS as span-<serial>.local.
SPAN_HOST=10.100.6.21

# Optional; read from cached credentials when unset.
# SPAN_SERIAL=<local-serial>

# Credential and certificate cache. Shared with SPAN's own scripts/span-auth.
SPAN_AUTH_FILE=~/.span-auth.json
SPAN_CA_CERT_DIR=~/.span-ca-certs

# --- Home Assistant MQTT broker ---------------------------------------------
HA_MQTT_HOST=10.100.6.10
HA_MQTT_PORT=1883
HA_MQTT_USERNAME=
HA_MQTT_PASSWORD=
HA_DISCOVERY_PREFIX=homeassistant

# --- behavior ---------------------------------------------------------------
LOG_LEVEL=INFO
# Republish only when a value changes. Set to 0 to forward every message, which
# will grow the HA recorder database quickly on a fast-moving panel.
PUBLISH_ON_CHANGE_ONLY=1
