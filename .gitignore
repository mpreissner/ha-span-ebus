.env
*.pyc
__pycache__/
.venv/
venv/
*.egg-info/
dist/
build/
.pytest_cache/
.ruff_cache/

# uv writes this on first `uv run`. CI installs with pip from pyproject.toml and
# never reads it, and nothing here is published as a package, so a committed
# lockfile would pin nothing that actually runs.
uv.lock

# Never commit panel credentials or certificates.
.span-auth.json
*.crt
*.pem
span-ca-certs/
# Throwaway certificates made for the TLS tests; no panel's.
!tests/fixtures/tls/*.pem

# Runtime token caches (local + HA config dir).
.span_ebus/
.span-cloud.json
span_at.txt
span_id.txt
span-capture.txt

.claude/

# MemPalace per-project files (issue #185)
mempalace.yaml
entities.json
.mempalace/
